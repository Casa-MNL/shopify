{{ 'component-card.css' | asset_url | stylesheet_tag }}
{{ 'component-price.css' | asset_url | stylesheet_tag }}
{{ 'component-slider.css' | asset_url | stylesheet_tag }}
{{ 'template-collection.css' | asset_url | stylesheet_tag }}

{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}
  .collections-grid-container {
    max-width: {{ section.settings.container_width }}%;
    margin: 0 auto;
    width: 100%;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.grid_gap }}rem;
    margin-bottom: 4rem;
  }
  
  .collection-card {
    border: 1px solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}rem;
    background: rgba(var(--color-background));
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    transition: all 0.2s ease;
  }

  .collection-card:hover {
    box-shadow: 0 4px 16px rgba(0, 0, 0, {{ section.settings.shadow_opacity | plus: 4 | divided_by: 100.0 }});
    transform: translateY(-{{ section.settings.hover_lift }}px);
  }
  
  .collection-card__title {
    text-align: center;
    margin-bottom: {{ section.settings.title_spacing }}rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
  }

  .collection-card__title h3 {
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }
  
  .collection-card__products {
    display: grid;
    gap: {{ section.settings.product_gap }}rem;
    grid-template-columns: 1fr;
  }

  .collection-card__products .card-wrapper {
    margin: 0;
  }

  /* Responsive design */
  @media screen and (max-width: 989px) {
    .collections-grid-container {
      max-width: 90%;
    }
    
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 2rem;
      margin-bottom: 3rem;
    }
    
    .collection-card {
      padding: 2rem;
    }
  }
  
  @media screen and (max-width: 749px) {
    .collections-grid-container {
      max-width: 95%;
    }
    
    .collections-grid {
      grid-template-columns: 1fr;
      gap: 1.5rem;
      margin-bottom: 2rem;
    }
    
    .collection-card {
      padding: 1.5rem;
      border-radius: 8px;
    }

    .collection-card__title {
      margin-bottom: 1.5rem;
      padding-bottom: 1rem;
    }

    .collection-card__products {
      gap: 1rem;
    }
  }

  @media screen and (min-width: 1440px) {
    .collections-grid-container {
      max-width: min({{ section.settings.container_width }}%, 1400px);
    }
  }
  
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}">
    
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin page-width">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}" style="text-align: center;">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}

    <div class="collections-grid page-width">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- if collection != blank -%}
          <div class="collection-card" {{ block.shopify_attributes }}>
            <!-- Collection Title -->
            <div class="collection-card__title">
              <h3 class="h4">{{ collection.title }}</h3>
              {%- if block.settings.show_description and collection.description != empty -%}
                <div class="collection__description rte">
                  {{ collection.description | strip_html | truncatewords: 20 }}
                </div>
              {%- endif -%}
            </div>

            <!-- Collection Products -->
            <div class="collection-card__products">
              {%- for product in collection.products limit: block.settings.products_to_show -%}
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_quick_add: section.settings.enable_quick_add,
                  section_id: section.id
                %}
              {%- else -%}
                {%- for i in (1..block.settings.products_to_show) -%}
                  {% render 'card-product', show_vendor: section.settings.show_vendor %}
                {%- endfor -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.show_view_all and collection.products_count > block.settings.products_to_show -%}
              <div class="center collection__view-all">
                <a
                  href="{{ collection.url }}"
                  class="button button--secondary"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
                >
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <!-- Placeholder if no collection selected -->
          <div class="collection-card">
            <div class="collection-card__title">
              <h3 class="h4">Collection {{ forloop.index }}</h3>
            </div>
            <div class="collection-card__products">
              {%- for i in (1..block.settings.products_to_show) -%}
                {% render 'card-product', show_vendor: section.settings.show_vendor %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured Collections",
      "label": "Section Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Container Width",
      "default": 80,
      "info": "Width of the collections container"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "rem",
      "label": "Grid Gap",
      "default": 3,
      "info": "Space between collection cards"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "rem",
      "label": "Card Padding",
      "default": 6,
      "info": "Inner padding of collection cards"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 12,
      "info": "Rounded corners of collection cards"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Border Opacity",
      "default": 8,
      "info": "Opacity of card borders (0 = invisible, 20 = visible)"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Shadow Intensity",
      "default": 4,
      "info": "Intensity of card shadows (0 = no shadow)"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "rem",
      "label": "Title Bottom Spacing",
      "default": 2,
      "info": "Space below collection titles"
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "rem",
      "label": "Product Gap",
      "default": 2,
      "info": "Space between products in cards"
    },
    {
      "type": "header",
      "content": "Animation Settings"
    },
    {
      "type": "range",
      "id": "hover_lift",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Hover Lift Effect",
      "default": 2,
      "info": "How much cards lift on hover (0 = no effect)"
    },
    {
      "type": "range",
      "id": "hover_shadow_boost",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Hover Shadow Boost",
      "default": 100,
      "info": "How much shadow increases on hover"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image Ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show Secondary Image"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show Vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show Rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable Quick Add"
    },
    {
      "type": "header",
      "content": "Section Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Top",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding Bottom",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "featured_collection",
      "name": "Featured Collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "range",
          "id": "products_to_show",
          "min": 2,
          "max": 8,
          "step": 1,
          "default": 4,
          "label": "Products to Show"
        },
        {
          "type": "checkbox",
          "id": "show_description",
          "label": "Show Collection Description",
          "default": false
        },
        {
          "type": "checkbox",
          "id": "show_view_all",
          "default": true,
          "label": "Show View All Button"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Multiple Featured Collections",
      "blocks": [
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        },
        {
          "type": "featured_collection"
        }
      ]
    }
  ]
}
{% endschema %}