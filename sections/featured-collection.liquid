{%- if section.settings.enable_quick_add -%}
  {{ 'quick-add.css' | asset_url | stylesheet_tag }}
  <script src="{{ 'quick-add.js' | asset_url }}" defer="defer"></script>
  <script src="{{ 'product-form.js' | asset_url }}" defer="defer"></script>
{%- endif -%}

{%- style -%}

/* Start-FULL CONTROL of WRAPPER and HR */
.flex-wrapper {
  display: flex;
  flex-direction: {{ section.settings.flex_direction }};
  flex-wrap: {{ section.settings.flex_wrap }};
  justify-content: {{ section.settings.justify_content }};
  align-items: {{ section.settings.align_items }};
  align-content: {{ section.settings.align_content }};
  gap: {{ section.settings.gap }}px;
  padding: {{ section.settings.wrapper_padding_top }}px {{ section.settings.wrapper_padding_right }}px {{ section.settings.wrapper_padding_bottom }}px {{ section.settings.wrapper_padding_left }}px;
  margin: {{ section.settings.wrapper_margin_top }}px 0 {{ section.settings.wrapper_margin_bottom }}px 0;
  transition: all {{ section.settings.transition_duration }}ms ease;
}

.item {
  width: {{ section.settings.item_width }}px;
  {% if section.settings.item_min_width > 0 %}
    min-width: {{ section.settings.item_min_width }}px;
  {% endif %}
  {% if section.settings.item_max_width > 0 %}
    max-width: {{ section.settings.item_max_width }}px;
  {% endif %}
  {% if section.settings.item_height > 0 %}
    height: {{ section.settings.item_height }}px;
  {% endif %}
  flex-grow: {{ section.settings.item_grow }};
  flex-shrink: {{ section.settings.item_shrink }};
  align-self: {{ section.settings.item_align_self }};
  padding: {{ section.settings.item_padding }}px;
  margin: {{ section.settings.item_margin }}px;
  border-radius: {{ section.settings.item_border_radius }}px;
  transition: all {{ section.settings.transition_duration }}ms ease;
}

{% if section.settings.enable_hover_effects %}
.item:hover {
  transform: scale({{ section.settings.hover_scale | divided_by: 100.0 }});
}
{% endif %}

{% if section.settings.enable_responsive %}
@media screen and (max-width: 768px) {
  .flex-wrapper {
    flex-direction: {% if section.settings.mobile_flex_direction == 2 %}column{% else %}row{% endif %};
    gap: {{ section.settings.mobile_gap }}px;
  }
  
  .item {
    width: {{ section.settings.mobile_item_width }}px;
  }
}
{% endif %}

/* Small HR Element Styles */
small hr.zeroMarginBottomTop {
  margin: 0 !important;
  padding: 0 !important;
  border: none;
  height: 1px;
  background-color: currentColor;
  opacity: 0.2;
}

/* Alternative thin line version */
small hr.zeroMarginBottomTop.thin {
  height: 0.5px;
}

/* Thick line version */
small hr.zeroMarginBottomTop.thick {
  height: 2px;
}

/* Dashed line version */
small hr.zeroMarginBottomTop.dashed {
  background: transparent;
  border-top: 1px dashed currentColor;
  height: 0;
}

/* Dotted line version */
small hr.zeroMarginBottomTop.dotted {
  background: transparent;
  border-top: 1px dotted currentColor;
  height: 0;
}

/* Colored variations */
small hr.zeroMarginBottomTop.primary {
  background-color: var(--color-primary);
}

small hr.zeroMarginBottomTop.accent {
  background-color: var(--color-accent);
}

/* Responsive adjustments */
@media screen and (max-width: 749px) {
  small hr.zeroMarginBottomTop {
    margin: 0 !important;
  }
}

/* Accessibility - ensure sufficient contrast */
@media (prefers-contrast: high) {
  small hr.zeroMarginBottomTop {
    opacity: 0.6;
  }
}

/* Reduced motion support */
@media (prefers-reduced-motion: reduce) {
  small hr.zeroMarginBottomTop {
    transition: none;
  }
}

/* END-FULL CONTROL of WRAPPER and HR*/



  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .collections-grid-container {
    max-width: {{ section.settings.container_width }}%;
    margin: 0 auto;
    width: 100%;
  }

  .collections-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: {{ section.settings.grid_gap }}rem;
    margin-bottom: 4rem;
  }
  
  .collection-card {
    border: 1px solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
    border-radius: {{ section.settings.card_border_radius }}px;
    padding: {{ section.settings.card_padding }}rem;
    background: rgba(var(--color-background));
    box-shadow: 0 2px 8px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    transition: all 0.3s ease;
  }

  .collection-card:hover {
    {% if section.settings.hover_shadow_boost > 0 %}
      box-shadow: 0 4px 16px rgba(0, 0, 0, {{ section.settings.shadow_opacity | plus: section.settings.hover_shadow_boost | divided_by: 100.0 }});
    {% else %}
      box-shadow: 0 4px 16px rgba(0, 0, 0, {{ section.settings.shadow_opacity | divided_by: 100.0 }});
    {% endif %}
    {% if section.settings.hover_lift > 0 %}
      transform: translateY(-{{ section.settings.hover_lift }}px);
    {% endif %}
  }
  
  .collection-card__title {
    text-align: center;
    margin-bottom: {{ section.settings.title_spacing }}rem;
    padding-bottom: 1.5rem;
    border-bottom: 1px solid rgba(var(--color-foreground), {{ section.settings.border_opacity | divided_by: 100.0 }});
  }

  .collection-card__title h3 {
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }
  
  .collection-card__products {
    display: grid;
    gap: {{ section.settings.product_gap }}rem;
    grid-template-columns: 1fr;
  }

  .collection-card__products .card-wrapper {
    margin: 0;
  }

  /* Price display styles - FIXED */
  {% unless section.settings.show_price %}
    .collection-card .price,
    .collection-card .card-information__price,
    .collection-card .product-price {
      display: none !important;
    }
  {% endunless %}

  {% unless section.settings.show_compare_price %}
    .collection-card .price--on-sale .price-item--regular,
    .collection-card .price__sale del,
    .collection-card .compare-at-price,
    .collection-card .product-compare-price {
      display: none !important;
    }
  {% endunless %}

  {% if section.settings.show_price %}
    .collection-card .price,
    .collection-card .card-information__price .price,
    .collection-card .product-price {
      {% if section.settings.price_font_size != 14 %}
        font-size: {{ section.settings.price_font_size }}px;
      {% endif %}
      {% if section.settings.price_color != '#4a4a4a' %}
        color: {{ section.settings.price_color }};
      {% endif %}
      {% if section.settings.price_font_weight != 500 %}
        font-weight: {{ section.settings.price_font_weight }};
      {% endif %}
    }
  {% endif %}

  {% if section.settings.show_compare_price %}
    .collection-card .price--on-sale .price-item--regular,
    .collection-card .price__sale del,
    .collection-card .compare-at-price,
    .collection-card .product-compare-price {
      {% if section.settings.compare_price_font_size != 12 %}
        font-size: {{ section.settings.compare_price_font_size }}px;
      {% endif %}
      {% if section.settings.compare_price_color != '#a0a0a0' %}
        color: {{ section.settings.compare_price_color }};
      {% endif %}
    }
  {% endif %}

  /* Responsive design */
  @media screen and (max-width: 989px) {
    .collections-grid-container {
      max-width: 90%;
    }
    
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.grid_gap | times: 0.75 | round: 2 }}rem;
      margin-bottom: 3rem;
    }
    
    .collection-card {
      padding: {{ section.settings.card_padding | times: 0.75 | round: 2 }}rem;
    }
  }
  
  @media screen and (max-width: 749px) {
    .collections-grid-container {
      max-width: 95%;
    }
    
    .collections-grid {
      grid-template-columns: 1fr;
      gap: {{ section.settings.grid_gap | times: 1.5 | round: 2 }}rem;
      margin-bottom: 2rem;
    }
    
    .collection-card {
      padding: {{ section.settings.card_padding | times: 0.6 | round: 2 }}rem;
      border-radius: {{ section.settings.card_border_radius | times: 0.8 | round: 0 }}px;
    }

    .collection-card__title {
      margin-bottom: {{ section.settings.title_spacing | times: 0.75 | round: 2 }}rem;
      padding-bottom: 1rem;
    }

    .collection-card__products {
      gap: {{ section.settings.product_gap | times: 0.75 | round: 2 }}rem;
    }
  }

  @media screen and (min-width: 1440px) {
    .collections-grid-container {
      max-width: min({{ section.settings.container_width }}%, 1400px);
    }
  }

  @media screen and (min-width: 990px) and (max-width: 1199px) {
    .collections-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
{%- endstyle -%}

<div class="color-{{ section.settings.color_scheme }} isolate gradient">
  <div class="collection section-{{ section.id }}-padding{% if section.settings.full_width %} collection--full-width{% endif %}" 
       style="--container-width: {{ section.settings.container_width }}%;">
    
    {%- if section.settings.title != blank -%}
      <div class="title-wrapper title-wrapper--no-top-margin" style="max-width: {{ section.settings.container_width }}%; margin: 0 auto;">
        <h2 class="title inline-richtext {{ section.settings.heading_size }}" style="text-align: center; margin-bottom: {{ section.settings.title_spacing }}rem;">
          {{ section.settings.title }}
        </h2>
      </div>
    {%- endif -%}
 
    <div class="collections-grid" style="
      max-width: {{ section.settings.container_width }}%;
      margin: 0 auto;
      gap: {{ section.settings.grid_gap }}rem;
      {% if section.settings.shadow_opacity > 0 %}
        --card-shadow: 0 4px 12px rgba(0,0,0,{{ section.settings.shadow_opacity | divided_by: 100.0 }});
      {% endif %}
    ">
      {%- for block in section.blocks -%}
        {%- assign collection = block.settings.collection -%}
        {%- if collection != blank -%}
          <div class="collection-card" {{ block.shopify_attributes }} style="
            padding: {{ section.settings.card_padding }}rem;
            border-radius: {{ section.settings.card_border_radius }}px;
            {% if section.settings.border_opacity > 0 %}
              border: 1px solid rgba(0,0,0,{{ section.settings.border_opacity | divided_by: 100.0 }});
            {% endif %}
            box-shadow: var(--card-shadow, none);
            transition: all 0.3s ease;
            {% if section.settings.hover_lift > 0 or section.settings.hover_shadow_boost > 0 %}
              --hover-lift: {{ section.settings.hover_lift }}px;
              --hover-shadow-boost: {{ section.settings.hover_shadow_boost | divided_by: 100.0 }};
            {% endif %}
          " 
          onmouseover="this.style.transform='translateY(calc(-1 * var(--hover-lift, 0px)))'; this.style.boxShadow='{% if section.settings.shadow_opacity > 0 %}0 calc(4px + var(--hover-lift, 0px)) calc(12px * (1 + var(--hover-shadow-boost, 0))) rgba(0,0,0,{{ section.settings.shadow_opacity | divided_by: 100.0 }} * (1 + var(--hover-shadow-boost, 0))){% else %}none{% endif %}';"
          onmouseout="this.style.transform='translateY(0)'; this.style.boxShadow='var(--card-shadow, none)';">
            
            <!-- Collection Title -->
            <div class="collection-card__title">
              <h3 class="h4">{{ collection.title }}</h3>
              {%- if block.settings.show_description and collection.description != empty -%}
                <div class="collection__description rte">
                  {{ collection.description | strip_html | truncatewords: 20 }}
                </div>
              {%- endif -%}
              <small><br><hr class="zeroMarginBottomTop"></small>
            </div>

            <!-- Collection Products -->
            <div class="collection-card__products" style="gap: {{ section.settings.product_gap }}rem;">
              {%- for product in collection.products limit: block.settings.products_to_show -%}
                {% render 'card-product',
                  card_product: product,
                  media_aspect_ratio: section.settings.image_ratio,
                  show_secondary_image: section.settings.show_secondary_image,
                  show_vendor: section.settings.show_vendor,
                  show_rating: section.settings.show_rating,
                  show_quick_add: section.settings.enable_quick_add,
                  show_price: section.settings.show_price,
                  show_compare_price: section.settings.show_compare_price,
                  price_font_size: section.settings.price_font_size,
                  compare_price_font_size: section.settings.compare_price_font_size,
                  price_color: section.settings.price_color,
                  compare_price_color: section.settings.compare_price_color,
                  price_font_weight: section.settings.price_font_weight,
                  section_id: section.id
                %}
              {%- else -%}
                {%- for i in (1..block.settings.products_to_show) -%}
                  {% render 'card-product', 
                    show_vendor: section.settings.show_vendor,
                    show_price: section.settings.show_price,
                    show_compare_price: section.settings.show_compare_price
                  %}
                {%- endfor -%}
              {%- endfor -%}
            </div>

            {%- if block.settings.show_view_all and collection.products_count > block.settings.products_to_show -%}
              <div class="center collection__view-all">
                <a
                  href="{{ collection.url }}"
                  class="button button--secondary"
                  aria-label="{{ 'sections.featured_collection.view_all_label' | t: collection_name: collection.title }}"
                >
                  {{ 'sections.featured_collection.view_all' | t }}
                </a>
              </div>
            {%- endif -%}
          </div>
        {%- else -%}
          <!-- Placeholder if no collection selected -->
          <div class="collection-card" style="
            padding: {{ section.settings.card_padding }}rem;
            border-radius: {{ section.settings.card_border_radius }}px;
            {% if section.settings.border_opacity > 0 %}
              border: 1px solid rgba(0,0,0,{{ section.settings.border_opacity | divided_by: 100.0 }});
            {% endif %}
            box-shadow: var(--card-shadow, none);
          ">
            <div class="collection-card__title">
              <h3 class="h4">Collection {{ forloop.index }}</h3>
            </div>
            <div class="collection-card__products" style="gap: {{ section.settings.product_gap }}rem;">
              {%- for i in (1..block.settings.products_to_show) -%}
                {% render 'card-product', 
                  show_vendor: section.settings.show_vendor,
                  show_price: section.settings.show_price,
                  show_compare_price: section.settings.show_compare_price
                %}
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Featured Collections",
  "tag": "section",
  "class": "section",
  "max_blocks": 3,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "inline_richtext",
      "id": "title",
      "default": "Featured Collections",
      "label": "Section Title"
    },
    {
      "type": "select",
      "id": "heading_size",
      "options": [
        {
          "value": "h2",
          "label": "Small"
        },
        {
          "value": "h1",
          "label": "Medium"
        },
        {
          "value": "h0",
          "label": "Large"
        }
      ],
      "default": "h1",
      "label": "Heading Size"
    },
    {
      "type": "header",
      "content": "Layout Settings"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 60,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Container Width",
      "default": 60,
      "info": "Width of the collections container"
    },
    {
      "type": "range",
      "id": "grid_gap",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "rem",
      "label": "Grid Gap",
      "default": 3,
      "info": "Space between collection cards"
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 1,
      "max": 8,
      "step": 1,
      "unit": "rem",
      "label": "Card Padding",
      "default": 6,
      "info": "Inner padding of collection cards"
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 20,
      "step": 2,
      "unit": "px",
      "label": "Card Border Radius",
      "default": 0,
      "info": "Rounded corners of collection cards"
    },
    {
      "type": "range",
      "id": "border_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Border Opacity",
      "default": 8,
      "info": "Opacity of card borders (0 = invisible, 20 = visible)"
    },
    {
      "type": "header",
      "content": "Color Settings"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "options": [
        {
          "value": "accent-1",
          "label": "Accent 1"
        },
        {
          "value": "accent-2",
          "label": "Accent 2"
        },
        {
          "value": "background-1",
          "label": "Background 1"
        },
        {
          "value": "background-2",
          "label": "Background 2"
        },
        {
          "value": "inverse",
          "label": "Inverse"
        }
      ],
      "default": "background-1",
      "label": "Color Scheme"
    },
    {
      "type": "range",
      "id": "shadow_opacity",
      "min": 0,
      "max": 20,
      "step": 1,
      "unit": "%",
      "label": "Shadow Intensity",
      "default": 4,
      "info": "Intensity of card shadows (0 = no shadow)"
    },
    {
      "type": "header",
      "content": "Typography Settings"
    },
    {
      "type": "range",
      "id": "title_spacing",
      "min": 1,
      "max": 4,
      "step": 1,
      "unit": "rem",
      "label": "Title Bottom Spacing",
      "default": 2,
      "info": "Space below collection titles"
    },
    {
      "type": "range",
      "id": "product_gap",
      "min": 1,
      "max": 3,
      "step": 1,
      "unit": "rem",
      "label": "Product Gap",
      "default": 2,
      "info": "Space between products in cards"
    },
    {
      "type": "header",
      "content": "Animation Settings"
    },
    {
      "type": "range",
      "id": "hover_lift",
      "min": 0,
      "max": 5,
      "step": 1,
      "unit": "px",
      "label": "Hover Lift Effect",
      "default": 2,
      "info": "How much cards lift on hover (0 = no effect)"
    },
    {
      "type": "range",
      "id": "hover_shadow_boost",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "%",
      "label": "Hover Shadow Boost",
      "default": 100,
      "info": "How much shadow increases on hover"
    },
    {
      "type": "header",
      "content": "Product Card Settings"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "Adapt to image"
        },
        {
          "value": "portrait",
          "label": "Portrait"
        },
        {
          "value": "square",
          "label": "Square"
        }
      ],
      "default": "adapt",
      "label": "Image Ratio"
    },
    {
      "type": "checkbox",
      "id": "show_secondary_image",
      "default": false,
      "label": "Show Secondary Image"
    },
    {
      "type": "checkbox",
      "id": "show_vendor",
      "default": false,
      "label": "Show Vendor"
    },
    {
      "type": "checkbox",
      "id": "show_rating",
      "default": false,
      "label": "Show Rating"
    },
    {
      "type": "checkbox",
      "id": "enable_quick_add",
      "default": false,
      "label": "Enable Quick Add"
    },
    {
      "type": "header",
      "content": "Price Display Settings"
    },
    {
      "type": "checkbox",
      "id": "show_price",
      "default": true,
      "label": "Show Price",
      "info": "Display product prices"
    },
    {
      "type": "checkbox",
      "id": "show_compare_price",
      "default": true,
      "label": "Show Compare Price",
      "info": "Display original price when on sale"
    },
    {
      "type": "range",
      "id": "price_font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Price Font Size",
      "default": 14,
      "info": "Size of price text"
    },
    {
      "type": "range",
      "id": "compare_price_font_size",
      "min": 10,
      "max": 16,
      "step": 1,
      "unit": "px",
      "label": "Compare Price Font Size",
      "default": 12,
      "info": "Size of compare price text"
    },
    {
      "type": "color",
      "id": "price_color",
      "default": "#4a4a4a",
      "label": "Price Color",
      "info": "Color of regular price"
    },
    {
      "type": "color",
      "id": "compare_price_color",
      "default": "#a0a0a0",
      "label": "Compare Price Color",
      "info": "Color of compare price"
    },
    {
      "type": "range",
      "id": "price_font_weight",
      "min": 300,
      "max": 700,
      "step": 100,
      "label": "Price Font Weight",
      "default": 500,
      "info": "Weight of price text"
    },
    {
      "type": "header",
      "content": "Flex Layout Settings"
    },
    {
      "type": "select",
      "id": "flex_direction",
      "label": "Flex Direction",
      "options": [
        {
          "value": "row",
          "label": "Row"
        },
        {
          "value": "row-reverse",
          "label": "Row Reverse"
        },
        {
          "value": "column",
          "label": "Column"
        },
        {
          "value": "column-reverse",
          "label": "Column Reverse"
        }
      ],
      "default": "row"
    },
    {
      "type": "select",
      "id": "flex_wrap",
      "label": "Flex Wrap",
      "options": [
        {
          "value": "nowrap",
          "label": "No Wrap"
        },
        {
          "value": "wrap",
          "label": "Wrap"
        },
        {
          "value": "wrap-reverse",
          "label": "Wrap Reverse"
        }
      ],
      "default": "nowrap"
    },
    {
      "type": "select",
      "id": "justify_content",
      "label": "Justify Content",
      "options": [
        {
          "value": "flex-start",
          "label": "Flex Start"
        },
        {
          "value": "flex-end",
          "label": "Flex End"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "space-between",
          "label": "Space Between"
        },
        {
          "value": "space-around",
          "label": "Space Around"
        },
        {
          "value": "space-evenly",
          "label": "Space Evenly"
        }
      ],
      "default": "flex-start"
    },
    {
      "type": "select",
      "id": "align_items",
      "label": "Align Items",
      "options": [
        {
