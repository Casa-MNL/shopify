{% style %}
  .store-location-map {
    padding: 80px 20px;
    background-color: #fafafa;
  }

  .store-location-map__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center; /* ✅ vertically align items */
    gap: 50px;
  }

  @media screen and (min-width: 768px) {
    .store-location-map__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  .store-location-map__info {
    padding: 20px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center; /* ✅ vertically align text */
    text-align: left;
  }

  .store-location-map__title {
    font-size: 36px;
    font-weight: 400;
    color: #333;
    margin-bottom: 15px;
  }

  .store-location-map__address {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 30px;
  }

  .store-location-map__hours {
    margin-top: 20px;
  }

  .store-location-map__hours-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #333;
  }

  .store-location-map__hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .store-location-map__hours-item {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: #444;
    padding: 8px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  .store-location-map__map {
    text-align: center;
  }

  .store-location-map__frame {
    width: 100%;
    height: 420px;
    border: none;
    border-radius: 10px;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  }

  .store-location-map__map small a {
    color: #555;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .store-location-map__map small a:hover {
    color: #000;
  }
{% endstyle %}

<div class="store-location-map">
  <div class="store-location-map__container">
    
    <!-- LEFT COLUMN: INFO -->
    <div class="store-location-map__info">
      <h2 class="store-location-map__title">
        {{ section.settings.location_title | default: "Visit Our Store" }}
      </h2>
      
      <div class="store-location-map__address">
        {{ section.settings.location_address | default: "76-C Apo Street, Sta. Mesa Heights, Quezon City" }}
      </div>
      
      <div class="store-location-map__hours">
        <h3 class="store-location-map__hours-title">Business Hours</h3>
        <ul class="store-location-map__hours-list">
          <li class="store-location-map__hours-item">
            <span>Monday - Saturday</span>
            <span>10:00 AM - 5:00 PM</span>
          </li>
          <li class="store-location-map__hours-item">
            <span>Sunday</span>
            <span>*By schedule only</span>
          </li>
        </ul>
      </div>
    </div>

    <!-- RIGHT COLUMN: MAP -->
    <div class="store-location-map__map">
      <iframe 
        class="store-location-map__frame"
        src="https://www.openstreetmap.org/export/embed.html?bbox=120.9985%2C14.6245%2C121.0010%2C14.6260&amp;layer=mapnik"
        loading="lazy">
      </iframe>

      <div style="text-align: center; margin-top: 10px;">
        <small>
          <a href="https://www.openstreetmap.org/node/3237667642" target="_blank">
            View Larger Map
          </a>
        </small>
      </div>
    </div>
  </div>
</div>
