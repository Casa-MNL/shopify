{% style %}
  /* 🔴 LAYOUT & DESIGN — controls overall spacing and visual structure */
  .store-location-map {
    padding: 80px 20px;
    background-color: #fafafa;
  }

  /* 🔴 GRID — two-column responsive layout */
  .store-location-map__container {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 1fr;
    align-items: center;
    gap: 50px;
  }

  @media screen and (min-width: 768px) {
    .store-location-map__container {
      grid-template-columns: 1fr 1fr;
    }
  }

  /* 🔴 LEFT PANEL (text info) */
  .store-location-map__info {
    padding: 20px 30px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    text-align: left;
  }

  .store-location-map__title {
    font-size: 36px;
    font-weight: 400;
    color: #333;
    margin-bottom: 15px;
  }

  .store-location-map__address {
    font-size: 16px;
    line-height: 1.7;
    color: #555;
    margin-bottom: 30px;
  }

  /* 🔴 HOURS SECTION */
  .store-location-map__hours {
    margin-top: 20px;
  }

  .store-location-map__hours-title {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
    color: #333;
  }

  .store-location-map__hours-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .store-location-map__hours-item {
    display: flex;
    justify-content: space-between;
    font-size: 15px;
    color: #444;
    padding: 8px 0;
    border-bottom: 1px solid #e5e5e5;
  }

  /* 🔴 MAP SECTION */
  .store-location-map__map {
    text-align: center;
  }

  .store-location-map__frame {
    width: 100%;
    height: 420px;
    border: none;
    border-radius: 10px;
    box-shadow: 0 4px 25px rgba(0, 0, 0, 0.08);
  }

  .store-location-map__map small a {
    color: #555;
    text-decoration: underline;
    transition: color 0.2s ease;
  }

  .store-location-map__map small a:hover {
    color: #000;
  }
{% endstyle %}

<div class="store-location-map">
  <div class="store-location-map__container">
    
    <!-- 🔴 LEFT COLUMN — STORE INFORMATION -->
    <div class="store-location-map__info">
      <h2 class="store-location-map__title">
        {{ section.settings.store_title | default: "Visit Our Store" }}
      </h2>
      
      <div class="store-location-map__address">
        {{ section.settings.store_address | default: "76-C Apo Street, Sta. Mesa Heights, Quezon City" }}
      </div>
      
      <div class="store-location-map__hours">
        <h3 class="store-location-map__hours-title">
          {{ section.settings.hours_title | default: "Business Hours" }}
        </h3>
        <ul class="store-location-map__hours-list">
          {% for block in section.blocks %}
            <li class="store-location-map__hours-item">
              <span>{{ block.settings.day }}</span>
              <span>{{ block.settings.time }}</span>
            </li>
          {% endfor %}
        </ul>
      </div>
    </div>

    <!-- 🔴 RIGHT COLUMN — EMBEDDED MAP -->
    <div class="store-location-map__map">
      <iframe 
        class="store-location-map__frame"
        src="{{ section.settings.map_embed_url | default: 'https://www.openstreetmap.org/export/embed.html?bbox=120.9985%2C14.6245%2C121.0010%2C14.6260&amp;layer=mapnik' }}"
        loading="lazy">
      </iframe>

      <div style="text-align: center; margin-top: 10px;">
        <small>
          <a href="{{ section.settings.map_link | default: 'https://www.openstreetmap.org/node/3237667642' }}" target="_blank">
            View Larger Map
          </a>
        </small>
      </div>
    </div>
  </div>
</div>

<!-- 🔴 JSON-LD SCHEMA for SEO -->
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "LocalBusiness",
  "name": {{ section.settings.store_title | json }},
  "image": {{ shop.logo | img_url: '600x600' | prepend: shop.url | json }},
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ section.settings.store_address | json }},
    "addressLocality": {{ section.settings.city | json }},
    "addressRegion": {{ section.settings.region | json }},
    "addressCountry": {{ section.settings.country | json }}
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ section.settings.latitude | json }},
    "longitude": {{ section.settings.longitude | json }}
  },
  "url": {{ shop.url | json }},
  "openingHours": [
    {% for block in section.blocks %}
      "{{ block.settings.day }} {{ block.settings.time }}"{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ]
}
</script>

{% schema %}
{
  "name": "Store Location Map",
  "settings": [
    /* 🔴 BASIC DETAILS */
    { "type": "text", "id": "store_title", "label": "Store Name", "default": "Casa.MNL Display Room" },
    { "type": "text", "id": "store_address", "label": "Store Address", "default": "76-C Apo Street, Sta. Mesa Heights, Quezon City" },

    /* 🔴 MAP SETTINGS */
    { "type": "text", "id": "map_embed_url", "label": "Map Embed URL", "default": "https://www.openstreetmap.org/export/embed.html?bbox=120.9985%2C14.6245%2C121.0010%2C14.6260&amp;layer=mapnik" },
    { "type": "text", "id": "map_link", "label": "View Larger Map Link", "default": "https://www.openstreetmap.org/node/3237667642" },

    /* 🔴 META DATA FOR SEO */
    { "type": "text", "id": "hours_title", "label": "Business Hours Title", "default": "Operating Hours" },
    { "type": "text", "id": "city", "label": "City", "default": "Quezon City" },
    { "type": "text", "id": "region", "label": "Region/Province", "default": "Metro Manila" },
    { "type": "text", "id": "country", "label": "Country", "default": "Philippines" },
    { "type": "text", "id": "latitude", "label": "Latitude", "default": "14.6476" },
    { "type": "text", "id": "longitude", "label": "Longitude", "default": "121.0490" }
  ],

  /* 🔴 BLOCKS FOR DYNAMIC HOURS */
  "blocks": [
    {
      "type": "hours",
      "name": "Operating Hours",
      "settings": [
        { "type": "text", "id": "day", "label": "Day", "default": "Monday - Saturday" },
        { "type": "text", "id": "time", "label": "Hours", "default": "10:00 AM - 5:00 PM" }
      ]
    }
  ],

  /* 🔴 THEME EDITOR PRESET */
  "presets": [
    { "name": "Store Location Map", "category": "Contact & Info" }
  ]
}
{% endschema %}
