{% doc %}
  @prompt
    Create a custom Shopify section named “Featured Collection Grid — Decorative Figures” that replicates a refined collection showcase with this concept:
    Concept: Sculptural Home Accents — elegant forms that bring artistry and structure to interiors.
    Layout Requirements:
    A centered section title (default: “Decorative Figures”)
    
    
    A responsive product grid (2 columns on mobile, 4 columns on desktop)
    
    
    Each product card includes:
    
    
    Product image with consistent aspect ratio (around 3:4 or 150%)
    
    
    Product title below the image
    
    
    Product price, showing sale and compare-at-price when applicable
    
    
    Conditional badges: “Sale” and “Sold out”
    
    
    A centered “View all” button linking to the selected collection
    
    
    Schema Settings:
    Custom section title (text field)
    
    
    Selectable collection (collection picker)
    
    
    Product limit (number, default 8)
    
    
    Toggle “View all” button (checkbox)
    
    
    Technical Instructions:
    Use Liquid to loop through collections[section.settings.collection].products
    
    
    Follow Dawn theme conventions (grid, grid__item, product-card, etc.) for layout consistency
    
    
    Use {{ product.featured_image | img_url: '600x' }} for optimized responsive images
    
    
    Include proper alt="{{ product.title }}" attributes for accessibility
    
    
    Use minimal inline styles (only for aspect ratio padding)
    
    
    Maintain responsive design and spacing alignment with Dawn’s CSS
    
    
    Include a complete {% schema %} block with presets and clean JSON formatting
    
    
    The final section should express modern refinement and sculptural calm, suitable for displaying collectible decor and art pieces.
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-featured-collection-{{ ai_gen_id }} {
    padding: 60px 20px;
    background-color: #f8f8f8;
  }

  .ai-featured-collection__container-{{ ai_gen_id }} {
    max-width: 1600px;
    margin: 0 auto;
  }

  .ai-featured-collection__header-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 48px;
  }

  .ai-featured-collection__title-{{ ai_gen_id }} {
    font-size: 32px;
    font-weight: 300;
    letter-spacing: 0.5px;
    color: #4a4a4a;
    margin: 0;
  }

  .ai-featured-collection__grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 16px;
    margin-bottom: 48px;
  }

  @media screen and (min-width: 750px) {
    .ai-featured-collection__grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
    }
  }

  .ai-featured-collection__card-{{ ai_gen_id }} {
    position: relative;
    background-color: #ffffff;
    border-radius: 4px;
    overflow: hidden;
    transition: transform 0.3s ease;
  }

  .ai-featured-collection__card-{{ ai_gen_id }}:hover {
    transform: translateY(-4px);
  }

  .ai-featured-collection__image-wrapper-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    padding-bottom: 150%;
    overflow: hidden;
    background-color: #f4f4f4;
  }

  .ai-featured-collection__image-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ai-featured-collection__placeholder-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 60%;
    height: 60%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-featured-collection__placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-featured-collection__badge-{{ ai_gen_id }} {
    position: absolute;
    bottom: 12px;
    left: 12px;
    padding: 6px 12px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    border-radius: 40px;
    z-index: 1;
  }

  .ai-featured-collection__badge--sale-{{ ai_gen_id }} {
    background-color: #c0c0c0;
    color: #4a4a4a;
  }

  .ai-featured-collection__badge--sold-out-{{ ai_gen_id }} {
    background-color: #4a4a4a;
    color: #e5e5e5;
  }

  .ai-featured-collection__info-{{ ai_gen_id }} {
    padding: 16px;
    text-align: left;
  }

  .ai-featured-collection__product-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 400;
    color: #4a4a4a;
    margin: 0 0 8px;
    line-height: 1.4;
  }

  .ai-featured-collection__product-link-{{ ai_gen_id }} {
    text-decoration: none;
    color: inherit;
  }

  .ai-featured-collection__product-link-{{ ai_gen_id }}:hover .ai-featured-collection__product-title-{{ ai_gen_id }} {
    color: #8c8c8c;
  }

  .ai-featured-collection__price-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }

  .ai-featured-collection__price-regular-{{ ai_gen_id }} {
    color: #4a4a4a;
    font-weight: 500;
  }

  .ai-featured-collection__price-compare-{{ ai_gen_id }} {
    color: #a0a0a0;
    text-decoration: line-through;
    font-size: 13px;
  }

  .ai-featured-collection__footer-{{ ai_gen_id }} {
    text-align: center;
  }

  .ai-featured-collection__button-{{ ai_gen_id }} {
    display: inline-block;
    padding: 14px 32px;
    background-color: #8c8c8c;
    color: #e5e5e5;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    letter-spacing: 0.5px;
    text-transform: uppercase;
    border-radius: 2px;
    transition: background-color 0.3s ease;
  }

  .ai-featured-collection__button-{{ ai_gen_id }}:hover {
    background-color: #4a4a4a;
  }

  .ai-featured-collection__empty-{{ ai_gen_id }} {
    text-align: center;
    padding: 60px 20px;
    color: #a0a0a0;
    font-style: italic;
  }
{% endstyle %}

<div class="ai-featured-collection-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if block.settings.section_title != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ block.settings.section_title }}</h2>
      </div>
    {% endif %}

    {% if block.settings.collection != blank %}
      {% assign collection = collections[block.settings.collection] %}
      {% assign product_limit = block.settings.product_limit %}

      {% if collection.products.size > 0 %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
          {% for product in collection.products limit: product_limit %}
            <div class="ai-featured-collection__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__product-link-{{ ai_gen_id }}">
                <div class="ai-featured-collection__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 600 }}"
                      alt="{{ product.title | escape }}"
                      class="ai-featured-collection__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="600"
                      height="900"
                    >
                  {% else %}
                    <div class="ai-featured-collection__placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if product.available == false %}
                    <span class="ai-featured-collection__badge-{{ ai_gen_id }} ai-featured-collection__badge--sold-out-{{ ai_gen_id }}">
                      Sold out
                    </span>
                  {% elsif product.compare_at_price > product.price %}
                    <span class="ai-featured-collection__badge-{{ ai_gen_id }} ai-featured-collection__badge--sale-{{ ai_gen_id }}">
                      Sale
                    </span>
                  {% endif %}
                </div>

                <div class="ai-featured-collection__info-{{ ai_gen_id }}">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-featured-collection__price-{{ ai_gen_id }}">
                    <span class="ai-featured-collection__price-regular-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-featured-collection__price-compare-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        {% if block.settings.show_view_all %}
          <div class="ai-featured-collection__footer-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-featured-collection__button-{{ ai_gen_id }}">
              View all
            </a>
          </div>
        {% endif %}
      {% else %}
        <div class="ai-featured-collection__empty-{{ ai_gen_id }}">
          This collection is empty. Add products to display them here.
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-{{ ai_gen_id }}">
        Select a collection to display products.
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Featured collection grid",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Decorative Figures"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 16,
      "step": 2,
      "label": "Product limit",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Featured collection grid"
    }
  ]
}
{% endschema %}
