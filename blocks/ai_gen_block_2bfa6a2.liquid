> 
 
<div class="ai-featured-collection-{{ ai_gen_id }} bg-{{ section.settings.background_color }}" style="padding: {{ section.settings.section_padding }}px;">
  {% if section.settings.enable_hover_zoom %}
    <style>
      .ai-featured-collection__card-{{ ai_gen_id }} img {
        transition: transform 0.4s ease;
      }
      .ai-featured-collection__card-{{ ai_gen_id }}:hover img {
        transform: scale(1.05);
      }
    </style>
  {% endif %}

  <div class="ai-featured-collection__container-{{ ai_gen_id }}">
    {% if section.settings.section_title != blank %}
      <div class="ai-featured-collection__header-{{ ai_gen_id }}">
        <h2 class="ai-featured-collection__title-{{ ai_gen_id }}">{{ section.settings.section_title }}</h2>
      </div>
    {% endif %}

    {% if section.settings.collection != blank %}
      {% assign collection = collections[section.settings.collection] %}
      {% assign product_limit = section.settings.product_limit %}

      {% if collection.products.size > 0 %}
        <div class="ai-featured-collection__grid-{{ ai_gen_id }}">
          {% for product in collection.products limit: product_limit %}
            <div class="ai-featured-collection__card-{{ ai_gen_id }}">
              <a href="{{ product.url }}" class="ai-featured-collection__product-link-{{ ai_gen_id }}">
                <div class="ai-featured-collection__image-wrapper-{{ ai_gen_id }}">
                  {% if product.featured_image %}
                    <img
                      src="{{ product.featured_image | image_url: width: 300 }}"
                      alt="{{ product.title | escape }}"
                      class="ai-featured-collection__image-{{ ai_gen_id }}"
                      loading="lazy"
                      width="300"
                      height="450"
                    >
                  {% else %}
                    <div class="ai-featured-collection__placeholder-{{ ai_gen_id }}">
                      {{ 'product-1' | placeholder_svg_tag }}
                    </div>
                  {% endif %}

                  {% if product.available == false %}
                    <span class="ai-featured-collection__badge-{{ ai_gen_id }} ai-featured-collection__badge--sold-out-{{ ai_gen_id }}">
                      Sold out
                    </span>
                  {% elsif product.compare_at_price > product.price %}
                    <span class="ai-featured-collection__badge-{{ ai_gen_id }} ai-featured-collection__badge--sale-{{ ai_gen_id }}">
                      Sale
                    </span>
                  {% endif %}
                </div>

                <div class="ai-featured-collection__info-{{ ai_gen_id }}">
                  <h3 class="ai-featured-collection__product-title-{{ ai_gen_id }}">{{ product.title }}</h3>
                  <div class="ai-featured-collection__price-{{ ai_gen_id }}">
                    <span class="ai-featured-collection__price-regular-{{ ai_gen_id }}">
                      {{ product.price | money }}
                    </span>
                    {% if product.compare_at_price > product.price %}
                      <span class="ai-featured-collection__price-compare-{{ ai_gen_id }}">
                        {{ product.compare_at_price | money }}
                      </span>
                    {% endif %}
                  </div>
                </div>
              </a>
            </div>
          {% endfor %}
        </div>

        {% if section.settings.show_view_all %}
          <div class="ai-featured-collection__footer-{{ ai_gen_id }}">
            <a href="{{ collection.url }}" class="ai-featured-collection__button-{{ ai_gen_id }}">
              View all
            </a>
          </div>
        {% endif %}
      {% else %}
        <div class="ai-featured-collection__empty-{{ ai_gen_id }}">
          {{ section.settings.empty_state_text | default: "This collection is empty. Add products to display them here." }}
        </div>
      {% endif %}
    {% else %}
      <div class="ai-featured-collection__empty-{{ ai_gen_id }}">
        {{ section.settings.empty_state_text | default: "Select a collection to display products." }}
      </div>
    {% endif %}
  </div>
</div>

{% schema %}
