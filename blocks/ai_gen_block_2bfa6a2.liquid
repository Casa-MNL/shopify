  "settings": [
    {
      "type": "text",
      "id": "section_title",
      "label": "Section title",
      "default": "Decorative Figures"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "product_limit",
      "min": 2,
      "max": 16,
      "step": 2,
      "label": "Product limit",
      "default": 8
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show 'View all' button",
      "default": true
    },
    {
      "type": "header",
      "content": "Section Styling"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#f8f8f8"
    },
    {
      "type": "text",
      "id": "background_gradient",
      "label": "Background gradient (CSS gradient value)",
      "info": "Overrides background color if set"
    },
    {
      "type": "range",
      "id": "section_padding",
      "label": "Section padding (px)",
      "min": 0,
      "max": 120,
      "step": 10,
      "default": 60
    },
    {
      "type": "header",
      "content": "Title Styling"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "label": "Title font size (px)",
      "min": 16,
      "max": 60,
      "step": 2,
      "default": 32
    },
    {
      "type": "range",
      "id": "title_font_weight",
      "label": "Title font weight",
      "min": 100,
      "max": 900,
      "step": 100,
      "default": 300
    },
    {
      "type": "range",
      "id": "title_letter_spacing",
      "label": "Title letter spacing (px)",
